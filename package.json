{
  "name": "website",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "quick-preview": "nuxt build && nuxt preview",
    "production-build": "pm2 stop all && pm2 delete all && nuxt build && pm2 start",
    "postinstall": "nuxt prepare",
    "cleanup": "npx nuxi cleanup",
    "clean_npm": "rm -rf .nuxt node_modules package-lock.json",
    "npm_install": "npm i",
    "typesmd": "npm install @tailwindcss/typography",
    "installernpm": "npx nuxi module add icon",
    "audit": "npm audit",
    "set-role": "node bin/set-role.cjs",
    "test": "vitest run",
    "seed-users": "node bin/seed-users.cjs --count=20",
    "clean-db": "node bin/clean-db.cjs"
  },
  "dependencies": {
    "@iconify-json/material-symbols": "^1.2.88",
    "@nuxt/icon": "^1.10.3",
    "@nuxtjs/sitemap": "^7.4.3",
    "@nuxtjs/tailwindcss": "^6.13.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/markdown-it": "^14.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "daisyui": "^4.12.23",
    "dotenv": "^16.6.1",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-prism": "^2.3.1",
    "mongoose": "^8.10.1",
    "nuxt": "^3.15.4",
    "ssh2": "^1.17.0",
    "uuid": "^11.0.5",
    "vue": "latest",
    "vue-router": "latest",
    "ws": "^8.21.3",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@shikijs/markdown-it": "^3.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "sass": "^1.85.1",
    "vitest": "^4.1.9"
  }
